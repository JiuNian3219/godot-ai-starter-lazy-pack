root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.gd]
indent_style = tab
indent_size = tab

[*.ps1]
indent_style = space
indent_size = 4

[scripts/{build_lazy_pack,copy_template,verify,test_template_content,test_verification}.ps1]
charset = utf-8-bom

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
